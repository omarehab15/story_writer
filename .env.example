# =====================================================================
# story-service: ONE .env for everything. Copy to `.env` and fill it in.
#   cp .env.example .env
# Real environment variables always win over this file. To share one file
# between several module folders point ENV_FILE at it:  ENV_FILE=../.env
# =====================================================================

# ---------------------------------------------------------------------
# ACTIVE LLM PROVIDER  (change this one line to switch provider)
#   openrouter | groq | google        (google = Google AI Studio / Gemini API)
# ---------------------------------------------------------------------
LLM_PROVIDER=google

# ---- API keys: fill only the provider(s) you use ----------------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Google AI Studio key (GEMINI_API_KEY also works)
GOOGLE_API_KEY=

# ---- Models -----------------------------------------------------------
# Leave blank to use each provider's default below. Roles follow the spec:
#   large  = writer / critics / director      small = reviewers / locators
#   vision = VLM critic
# Precedence: LLM_MODEL_<ROLE>  >  <PROVIDER>_MODEL_<ROLE>  >  built-in default
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
LLM_MODEL_VISION=

GOOGLE_MODEL_LARGE=gemini-3.5-flash
GOOGLE_MODEL_SMALL=gemini-3.5-flash-lite
GOOGLE_MODEL_VISION=gemini-3.5-flash

OPENROUTER_MODEL_LARGE=google/gemini-3.5-flash
OPENROUTER_MODEL_SMALL=google/gemini-3.5-flash-lite
OPENROUTER_MODEL_VISION=google/gemini-3.5-flash

GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_VISION=openai/gpt-oss-120b

# ---- Optional provider tuning -----------------------------------------
# json_object = ask the API for JSON mode (falls back automatically if the model rejects it)
# none        = never send response_format
LLM_JSON_MODE=json_object
# low | medium | high  (blank = provider default). Reasoning models spend output tokens on
# thinking, so lower it if you see "output truncated" errors.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SEC=120
# Base URL overrides (rarely needed)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter attribution headers (optional)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=story-service

# ---- Pipeline limits (spec 11.1) ---------------------------------------
MAX_STAGE_ATTEMPTS=3
LLM_MAX_CONCURRENCY=8
MAX_TOKENS_PER_STORY=600000
LOG_LEVEL=INFO

# ---- Module 5 ----------------------------------------------------------
# Leave blank to use the bundled stand-in catalog (src/story_service/assets/catalog.json)
CATALOG_PATH=

# ---- Notebook / dev runner (s5_pipeline_tracker.ipynb) ------------------
# fake = offline FakeLLM fixtures (no key, no network)   real = the LLM_PROVIDER above
PIPELINE_MODE=fake
S5_AGE_GROUP=9-11               # 6-8 | 9-11 | 12-14 | 15-18
# Blank = bundled golden files. Point these at module 4's output to test your own story.
S5_SCRIPT_PATH=
S5_BRIEF_PATH=
# Where each run's prompts/responses/validation are saved (blank = <repo>/runs)
RUNS_DIR=

# ---------------------------------------------------------------------
# Used by OTHER modules (ignored here, listed so this stays the one file)
# ---------------------------------------------------------------------
# DATABASE_URL=
# BLOB_BACKEND=local
# BLOB_DIR=./data/blobs
# API_KEYS=
# PLAY_TOKEN_SECRET=
# WEBHOOK_SECRET=
# PUBLIC_BASE_URL=
# ALLOWED_EMBED_ORIGINS=
# TTS_PROVIDER=groq
# STT_PROVIDER=groq
# TTS_MODEL=canopylabs/orpheus-arabic-saudi
# STT_MODEL=whisper-large-v3
