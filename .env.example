# Select one: openrouter, google, groq
LLM_ACTIVE_PROVIDER=openrouter

# A JSON object per successful LLM request (input/output token usage only).
# This relative path is resolved from the command's current directory.
LLM_USAGE_LOG_PATH=logs/llm_usage.jsonl

# Maximum output tokens per S4 LLM call. Lower these if your provider reports
# insufficient credits; increase them only when longer output is necessary.
S4_WRITER_MAX_TOKENS=16000
S4_CRITIC_MAX_TOKENS=3000

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL_LARGE=google/gemini-2.5-flash
OPENROUTER_MODEL_SMALL=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_VISION=google/gemini-2.5-flash

# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL_LARGE=gemini-2.5-flash
GOOGLE_MODEL_SMALL=gemini-2.5-flash-lite
GOOGLE_MODEL_VISION=gemini-2.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
